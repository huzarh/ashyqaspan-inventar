# Live camera relay for app.py (fMP4 over HTTP, localhost only). Config with camera credentials lives in
# /etc/go2rtc/go2rtc.yaml (chmod 600); see deploy/go2rtc.example.yaml.
[Unit]
Description=go2rtc camera relay
After=network-online.target

[Service]
User=ubuntu
ExecStart=/usr/local/bin/go2rtc -config /etc/go2rtc/go2rtc.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
